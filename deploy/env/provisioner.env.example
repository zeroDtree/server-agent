# Account provisioner settings (deploy/env/provisioner.env in this repo)

# Poll interval in seconds (minimum 5)
PROVISION_POLL_INTERVAL=30

# Path to isolation scripts (default: account-provisioner/isolation under repo root)
# ISOLATION_DIR=/path/to/server-agent/account-provisioner/isolation

# Absolute data root for add-user.sh / remove-user.sh
DATA_ROOT=/data

# Script that prints the SSH-reachable IPv4 on stdout (default: hooks/ipv4.sh)
# PROVISION_IPV4_CALLBACK=/path/to/my-ipv4.sh

# Use sudo -n when not root (1 = yes, 0 = no)
PROVISION_USE_SUDO=1

# Dry run: log only, no scripts or complete callbacks (1 = yes)
# PROVISION_DRY_RUN=0

# Localhost health endpoint (0 = disabled)
AGENT_HEALTH_HOST=127.0.0.1
AGENT_HEALTH_PORT=9091
