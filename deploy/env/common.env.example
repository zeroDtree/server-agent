# Shared agent settings (deploy/env/common.env in this repo)
# Used by both account-provisioner and gpu-server-report.

# Report API base URL (no trailing slash). account-provisioner uses this
# when UPSTREAM_API_URL is unset.
REPORT_API_URL=http://localhost:8080

# Optional provisioner API URL (defaults to REPORT_API_URL in the agent)
# UPSTREAM_API_URL=http://localhost:8080

# Per-server PSK (hex); must match central server config for this AGENT_SERVER_ID
AGENT_PSK=replace-with-agent-psk

# Required. Server id (must match X-Agent-Server-Id and JSON serverId)
AGENT_SERVER_ID=gpu-node-01
